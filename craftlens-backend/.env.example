# ─────────────────────────────────────────────────────────────
# CraftLens — environment variable template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── LLM provider (pick one) ───────────────────────────────────
# Options: groq | gemini | ollama
LLM_PROVIDER=groq

# Groq free tier — get key at https://console.groq.com/ (no card required)
GROQ_API_KEY=

# Groq model name — free-tier options (as of 2026):
#   qwen/qwen3.8-27b (recommended) | groq/compound-mini | allam-2-7b
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini free tier — https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (fully local) — run `ollama serve` and pull a model first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── ASR provider ──────────────────────────────────────────────
# Options: whisper | bhashini
ASR_PROVIDER=whisper

# Whisper model size: tiny | base | small | medium | large
# 'base' (~145 MB) is recommended for dev machines
WHISPER_MODEL_SIZE=base

# Bhashini (optional government ASR for Indian languages)
# Register at https://bhashini.gov.in/
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ── Pricing / FAISS ───────────────────────────────────────────
PRICE_INDEX_PATH=./data/price_index.faiss
PRICE_METADATA_PATH=./data/price_metadata.csv

# Sentence-transformer model for embeddings (pricing + consistency)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Persistence ───────────────────────────────────────────────
DATABASE_URL=sqlite:///./craftlens.db

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
STATIC_DIR=./static
MAX_UPLOAD_BYTES=10485760          # 10 MB
CONFIDENCE_THRESHOLD=0.7           # follow-up trigger below this
CONSISTENCY_THRESHOLD=0.4          # CLIP vs voice similarity threshold
PRICING_TOP_K=10                   # FAISS nearest neighbours
