# ─────────────────────────────────────────────
# CraftLens – environment variables template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── LLM providers (use whichever you have) ───
# Groq free tier: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (alternative LLM backend)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Bhashini (multilingual STT/TTS, optional) ─
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key

# ── LLM config ────────────────────────────────
# Model to use for field extraction and generation.
# Groq-hosted options (free): llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768
LLM_PROVIDER=groq
LLM_MODEL=llama3-8b-8192

# ── Whisper config ────────────────────────────
# Options: tiny | base | small | medium | large
# 'base' is recommended for low-resource dev machines.
WHISPER_MODEL=base

# ── Pricing / FAISS ───────────────────────────
# Path where the pre-built FAISS index + metadata CSV are stored.
FAISS_INDEX_PATH=data/faiss.index
FAISS_METADATA_PATH=data/product_metadata.csv

# ── Embedding model ───────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── App ───────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./craftlens.db
STATIC_DIR=static
